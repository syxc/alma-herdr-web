{
  "name": "alma-herdr-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web client for Alma herdr: pairs with the Alma desktop over the Alma relay, or talks to the local herdr socket through its own agent.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:agent && npm run build:worker && npm run build:mock",
    "build:agent": "tsc -p tsconfig.agent.json",
    "build:web": "tsc -p web/tsconfig.json && node scripts/copy-vendor.mjs",
    "build:mock": "tsc -p tsconfig.mock.json",
    "build:icons": "uv run --no-project --with 'fonttools[woff]==4.68.0' python scripts/subset-icon-font.py",
    "check:icons": "uv run --no-project --with 'fonttools[woff]==4.68.0' python scripts/subset-icon-font.py --check",
    "build:worker": "npm run build:web && node scripts/build-worker.mjs",
    "dev:worker": "wrangler dev --ip 127.0.0.1",
    "check:worker": "wrangler deploy --dry-run",
    "deploy:worker": "wrangler deploy",
    "start": "node agent/dist/index.js",
    "mock": "node mock/dist/herdr-mock.js",
    "format": "biome format --config-path=. --write .",
    "format:check": "biome format --config-path=. .",
    "lint": "biome lint --config-path=. --error-on-warnings .",
    "check": "biome check --config-path=. --error-on-warnings .",
    "check:fix": "biome check --config-path=. --write .",
    "typecheck": "tsc -p tsconfig.agent.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.mock.json --noEmit",
    "test": "node --test tests/*.test.js",
    "privacy-check": "node scripts/privacy-check.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
